{
  "name": "n8n-nodes-geosearchleads",
  "version": "0.1.1",
  "description": "n8n node for GEO Search Leads: run lite and full GEO scans of a website and get its full report.",
  "license": "MIT",
  "homepage": "https://geosearchleads.com",
  "keywords": [
    "n8n-community-node-package",
    "geo",
    "generative engine optimization",
    "seo",
    "geo search leads"
  ],
  "author": {
    "name": "GEO Search Leads",
    "email": "team@geosearchleads.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alifar/n8n-nodes-geosearchleads.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GeoSearchLeadsOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GeoSearchLeads/GeoSearchLeads.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
